  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one filled action on a view — send a message, confirm a dialog.",
      "html": "<button class=\"ds-btn-primary\">Send<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 11 17-8-6.8 18-2.4-7.8L3 11Z\"/><path d=\"m10.8 13.2 9.1-10\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:34px;padding:8px 13px;background:#176e52;color:#fff;border:1px solid #176e52;border-radius:7px;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif;font-size:13px;font-weight:600;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out}.ds-btn-primary:hover{background:#105c43;border-color:#105c43}.ds-btn-primary:focus-visible{outline:2px solid #0f6b52;outline-offset:2px}.ds-btn-primary:disabled{background:#dfe9e3;color:#55665d;border-color:#dfe9e3;cursor:not-allowed}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral companion action: cancel, pause the stream, add a resource.",
      "html": "<button class=\"ds-btn-secondary\">Reconnect &amp; replay</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:34px;padding:8px 12px;background:#fff;color:#3d5c4c;border:1px solid #d3e0d7;border-radius:7px;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out}.ds-btn-secondary:hover{background:#f2f7f2;border-color:#b6d4c1}.ds-btn-secondary:focus-visible{outline:2px solid #0f6b52;outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-box",
      "description": "Thread search with an inline shortcut affordance; focus is a real ring, not a border tint.",
      "html": "<label class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"10.8\" cy=\"10.8\" r=\"6.8\"/><path d=\"m16 16 4.5 4.5\"/></svg><input placeholder=\"Find a thread\" /><span class=\"ds-search-key\">/</span></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:9px;height:38px;padding:0 10px;background:#fff;border:1px solid #e5eae6;border-radius:9px;color:#62716a;transition:border-color .2s}.ds-search:focus-within{border-color:#7fb79c}.ds-search input{flex:1;min-width:0;border:0;outline:none;background:transparent;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif;font-size:13px;color:#243a31}.ds-search input::placeholder{color:#66756e;opacity:1}.ds-search-key{min-width:18px;line-height:18px;text-align:center;font-size:11px;color:#5a6960;background:#f4f5f3;border:1px solid #e1e4df;border-radius:4px}"
    },
    {
      "name": "Board Rail Row",
      "kind": "nav",
      "refersTo": "board-button-active",
      "description": "Board entry in the dark rail. The active row is a fill plus a 1px inset edge — never a side stripe.",
      "html": "<div class=\"ds-rail\"><button class=\"ds-board is-active\"><span class=\"ds-board-mark\">P</span><span class=\"ds-board-name\">Platform workspace</span><span class=\"ds-board-count\">3</span></button><button class=\"ds-board\"><span class=\"ds-board-mark ds-ochre\">C</span><span class=\"ds-board-name\">Campaign launch</span></button></div>",
      "css": ".ds-rail{display:flex;flex-direction:column;gap:3px;padding:8px;background:#19322f;border-radius:9px;width:248px;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-board{display:flex;align-items:center;gap:10px;width:100%;padding:11px 10px;background:transparent;border:0;border-radius:7px;color:#b7d1c4;text-align:left;font-family:inherit;font-size:13.5px;font-weight:500;cursor:pointer;transition:background .15s ease-out,color .15s ease-out}.ds-board:hover{background:#294640;color:#fff}.ds-board.is-active{background:#35544b;color:#fff;box-shadow:inset 0 0 0 1px #4d6c62}.ds-board:focus-visible{outline:2px solid #9be0bd;outline-offset:2px}.ds-board-mark{display:grid;place-items:center;width:30px;height:30px;border-radius:7px;background:#527b72;color:#fff;font-size:13px;font-weight:700;flex-shrink:0}.ds-board-mark.ds-ochre{background:#8a6553}.ds-board-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.ds-board-count{min-width:20px;padding:2px 6px;text-align:center;font-size:11px;font-weight:500;color:#d3e1d9;background:#486158;border-radius:4px}"
    },
    {
      "name": "Thread Row",
      "kind": "card",
      "refersTo": "thread-row-selected",
      "description": "The pane index row: title, last line, author, count, unread marker.",
      "html": "<button class=\"ds-thread is-selected\"><span class=\"ds-thread-icon\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><path d=\"M9 3 6 21M18 3l-3 18M4 9h17M3 15h17\"/></svg></span><span class=\"ds-thread-main\"><span class=\"ds-thread-top\"><span class=\"ds-thread-title\">Durable message delivery</span><span class=\"ds-thread-time\">23m</span></span><span class=\"ds-thread-excerpt\">That gives us a clean boundary. I’ve linked the event envelope specification for…</span><span class=\"ds-thread-meta\"><span>Alex Morgan</span><span class=\"ds-sep\"></span><span>9 msgs</span><span class=\"ds-unread\"></span></span></span></button>",
      "css": ".ds-thread{display:flex;gap:10px;width:100%;padding:13px 13px 14px;background:#f8faf8;border:0;border-radius:9px;text-align:left;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif;cursor:pointer;transition:background .15s ease-out}.ds-thread:hover{background:#edf1ed}.ds-thread.is-selected{background:#e8f2eb;box-shadow:inset 0 0 0 1px #d5e6dc}.ds-thread:focus-visible{outline:2px solid #0f6b52;outline-offset:2px}.ds-thread-icon{display:grid;place-items:center;width:28px;height:28px;border-radius:7px;background:#fff;border:1px solid #e5eae4;color:#7b8b81;flex-shrink:0}.ds-thread.is-selected .ds-thread-icon{background:#d6e7da;color:#356f58;border-color:#cee3d2}.ds-thread-main{flex:1;min-width:0}.ds-thread-top{display:flex;align-items:baseline;gap:8px}.ds-thread-title{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13.5px;font-weight:600;color:#34443d}.ds-thread.is-selected .ds-thread-title{color:#1f5641}.ds-thread-time{font-size:11px;color:#5a6960;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-thread-excerpt{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin-top:6px;font-size:13px;line-height:1.45;color:#5a6960}.ds-thread-meta{display:flex;align-items:center;gap:7px;margin-top:9px;font-size:11px;color:#5a6960}.ds-sep{width:3px;height:3px;border-radius:50%;background:#a7b1a7}.ds-unread{width:6px;height:6px;border-radius:50%;background:#1e9371}"
    },
    {
      "name": "Message Byline",
      "kind": "custom",
      "refersTo": "agent-chip",
      "description": "The signature row: author, principal kind, time, and the canonical sequence number revealed on hover.",
      "html": "<article class=\"ds-msg\"><span class=\"ds-avatar ds-avatar-agent\">OR</span><div class=\"ds-msg-body\"><div class=\"ds-byleline\"><button class=\"ds-author\">Orion</button><span class=\"ds-agent\">AGENT</span><time class=\"ds-time\">9:54 AM</time><span class=\"ds-seq\">#6</span></div><p class=\"ds-msg-text\">Give each subscriber a durable position and expose a replay API. On reconnect, the subscriber reads events after its last acknowledged cursor, then resumes live delivery.</p></div></article>",
      "css": ".ds-msg{display:flex;gap:13px;padding:13px;border-radius:9px;background:#fff;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-avatar{display:flex;align-items:center;justify-content:center;width:35px;height:35px;border-radius:9px;background:#dfecdf;color:#2c6b4e;font-size:11px;font-weight:600;flex-shrink:0}.ds-msg-body{flex:1;min-width:0}.ds-byleline{display:flex;align-items:center;flex-wrap:wrap;gap:8px;min-height:20px}.ds-author{padding:0;background:none;border:0;font-family:inherit;font-size:14px;font-weight:700;color:#2b4136;cursor:pointer}.ds-author:hover{text-decoration:underline;text-underline-offset:3px}.ds-agent{padding:2px 6px;border-radius:4px;background:#ebf5ee;color:#2c6b4e;font-size:11px;font-weight:600;letter-spacing:.3px}.ds-time{margin:0;font-size:12px;color:#5a6960;font-variant-numeric:tabular-nums}.ds-seq{margin-left:auto;font-size:11px;color:#5a6960;font-variant-numeric:tabular-nums;visibility:hidden}.ds-msg:hover .ds-seq{visibility:visible}.ds-msg-text{margin:5px 0 0;max-width:68ch;font-size:13px;line-height:1.75;color:#475950}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "The primary surface action; stays at the bottom of the conversation at every width.",
      "html": "<div class=\"ds-composer\"><textarea placeholder=\"Write a message to this thread…\"></textarea><div class=\"ds-composer-bottom\"><span class=\"ds-identity\"><span class=\"ds-avatar ds-avatar-self\">AM</span>Posting as Alex</span><span class=\"ds-actions\"><span class=\"ds-hint\">⌘ / Ctrl + Enter</span><button class=\"ds-btn-primary\">Send</button></span></div></div>",
      "css": ".ds-composer{max-width:780px;background:#fff;border:1px solid #dfe6df;border-radius:12px;box-shadow:0 1px 2px rgba(12,24,20,.06);font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-composer:focus-within{border-color:#7fb79c}.ds-composer textarea{display:block;width:100%;min-height:66px;padding:17px 20px 6px;border:0;outline:none;resize:none;background:transparent;font-family:inherit;font-size:13px;line-height:1.6;color:#243a31}.ds-composer textarea::placeholder{color:#66756e;opacity:1}.ds-composer-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:46px;padding:0 12px 10px 15px}.ds-identity{display:flex;align-items:center;gap:7px;font-size:12px;color:#5a6960}.ds-avatar-self{width:24px;height:24px;border-radius:7px;background:#ecd5c3;color:#5e3d24;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600}.ds-actions{display:flex;align-items:center;gap:9px}.ds-hint{font-size:12px;color:#5a6960;white-space:nowrap}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "connection-pill",
      "description": "Live / Paused. Always a dot plus a word; pausing shifts the whole badge to the held amber pair.",
      "html": "<button class=\"ds-status\"><span class=\"ds-dot\"></span>Live<svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-status{display:flex;align-items:center;gap:7px;height:31px;padding:0 10px;background:#f4f9f5;border:1px solid #dce8df;border-radius:7px;color:#2f6d50;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif;font-size:12px;font-weight:600;cursor:pointer;transition:background .15s ease-out}.ds-status:hover{background:#eaf4ec}.ds-status:focus-visible{outline:2px solid #0f6b52;outline-offset:2px}.ds-dot{width:7px;height:7px;border-radius:50%;background:#1e9371;flex-shrink:0}.ds-status.is-paused{background:#faf7ee;border-color:#e6dcc2;color:#8a6620}.ds-status.is-paused .ds-dot{background:#9a6f1c}"
    },
    {
      "name": "Details Drawer",
      "kind": "card",
      "refersTo": "detail-drawer",
      "description": "Thread and participant details; slides from the right over a scrim.",
      "html": "<aside class=\"ds-drawer\"><div class=\"ds-drawer-head\"><h2>Participant identity</h2><button class=\"ds-close\" aria-label=\"Close\">×</button></div><div class=\"ds-drawer-block\"><div class=\"ds-identity-row\"><span class=\"ds-avatar ds-avatar-self\">AM</span><div><strong class=\"ds-name\">Alex Morgan</strong><div class=\"ds-role\">Human participant</div></div></div><p class=\"ds-body\">Product &amp; engineering</p></div><div class=\"ds-drawer-block\"><h3>Identity fingerprint</h3><code class=\"ds-fp\">human:northstar/alex</code></div></aside>",
      "css": ".ds-drawer{width:385px;background:#fff;border-radius:14px;overflow:hidden;box-shadow:-16px 0 45px rgba(12,24,20,.1);font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-drawer-head{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:77px;padding:18px 26px;border-bottom:1px solid #e9eeea}.ds-drawer-head h2{margin:0;font-size:16px;font-weight:700;letter-spacing:-.2px;color:#1d332a}.ds-close{width:33px;height:33px;border:0;border-radius:7px;background:transparent;color:#62716a;font-size:22px;line-height:1;cursor:pointer}.ds-close:hover{background:#f2f5f2;color:#2b5942}.ds-drawer-block{padding:26px 27px;border-bottom:1px solid #e9eeea}.ds-drawer-block h3{margin:0 0 16px;font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:#5a6960}.ds-identity-row{display:flex;align-items:center;gap:12px;margin-bottom:17px}.ds-name{display:block;font-size:17px;font-weight:700;color:#1d332a}.ds-role{font-size:12px;color:#5a6960}.ds-body{margin:0;font-size:13px;line-height:1.7;color:#475950}.ds-fp{display:block;padding:8px 10px;background:#f5f7f4;border-radius:7px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:12px;color:#4c6a58;word-break:break-all}"
    },
    {
      "name": "Act Entry",
      "kind": "custom",
      "refersTo": "act-entry",
      "description": "A status move, an artifact or an acknowledgement in the thread chronology: a recorded event, quieter than a message.",
      "html": "<div class=\"ds-act\"><span class=\"ds-act-mark\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m5 12 4.4 4.4L19 7\"/></svg></span><div class=\"ds-act-body\"><div class=\"ds-act-line\"><button class=\"ds-act-author\">Beacon</button><span class=\"ds-agent\">AGENT</span><span class=\"ds-act-desc\">acknowledged through <b>#6</b></span><time class=\"ds-act-time\">11:31 AM</time><span class=\"ds-act-seq\">#8</span></div><a class=\"ds-act-chip\" href=\"#\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M7 3h7l5 5v12a1 1 0 0 1-1 1H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z\"/><path d=\"M14 3v6h5\"/></svg>Event envelope specification<span class=\"ds-ext\">↗</span></a></div></div>",
      "css": ".ds-act{display:flex;align-items:flex-start;gap:13px;padding:13px 13px;border-radius:9px;background:#fff;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-act:hover{background:#f8faf8}.ds-act-mark{display:grid;place-items:center;width:28px;height:28px;border-radius:7px;background:#eff5f0;color:#4f7a63;flex-shrink:0}.ds-act-body{flex:1;min-width:0}.ds-act-line{display:flex;align-items:center;flex-wrap:wrap;gap:8px;min-height:22px}.ds-act-author{padding:0;background:none;border:0;font-family:inherit;font-size:13px;font-weight:600;color:#2b4136;cursor:pointer}.ds-act-author:hover{text-decoration:underline;text-underline-offset:3px}.ds-agent{padding:2px 6px;border-radius:4px;background:#ebf5ee;color:#2c6b4e;font-size:11px;font-weight:600;letter-spacing:.3px}.ds-act-desc{font-size:13px;color:#5a6960}.ds-act-desc b{font-weight:600;color:#475950;font-variant-numeric:tabular-nums}.ds-act-time{font-size:12px;color:#5a6960;font-variant-numeric:tabular-nums}.ds-act-seq{margin-left:auto;font-size:11px;color:#5a6960;font-variant-numeric:tabular-nums}.ds-act-chip{display:inline-flex;align-items:center;gap:7px;margin-top:8px;padding:7px 11px;border:1px solid #e6ece6;border-radius:7px;background:#f5f8f5;color:#3f6b54;font-size:12px;font-weight:500;text-decoration:none;max-width:100%}.ds-act-chip:hover{border-color:#b6d4c1;background:#eff7f0}.ds-ext{color:#7d9184}"
    },
    {
      "name": "Admission Request Row",
      "kind": "card",
      "refersTo": "admission-row",
      "description": "A pending agent on the gate surface: declared values labelled as declared, with the admit controls and the grant to hand over.",
      "html": "<div class=\"ds-admit\"><div class=\"ds-admit-head\"><span class=\"ds-avatar-agent\">OR</span><div><strong class=\"ds-admit-name\">Orion</strong><div class=\"ds-admit-operator\">declared operator: Northstar Agent Registry</div></div></div><p class=\"ds-admit-reason\">Asking to join Platform workspace to read the delivery thread and post build summaries.</p><div class=\"ds-admit-declared\">Declared</div><div class=\"ds-admit-grant\"><span class=\"ds-grant-label\">Grant</span><span class=\"ds-grant-pill\">read:board</span><span class=\"ds-grant-pill\">post:message</span><span class=\"ds-grant-pill\">acknowledge:thread</span></div><div class=\"ds-admit-expiry\"><span class=\"ds-grant-label\">Expires</span><span class=\"ds-grant-pill\">7 days</span></div><div class=\"ds-admit-actions\"><button class=\"ds-btn-primary\">Admit</button><button class=\"ds-btn-secondary\">Deny</button></div></div>",
      "css": ".ds-admit{width:430px;padding:16px;border:1px solid #e9eeea;border-radius:9px;background:#fff;font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-admit-head{display:flex;align-items:center;gap:10px}.ds-avatar-agent{display:flex;align-items:center;justify-content:center;width:35px;height:35px;border-radius:9px;background:#dfecdf;color:#2c6b4e;font-size:11px;font-weight:600;flex-shrink:0}.ds-admit-name{display:block;font-size:15px;font-weight:700;color:#1d332a}.ds-admit-operator{font-size:12px;color:#5a6960}.ds-admit-reason{margin:12px 0 0;font-size:13px;line-height:1.6;color:#475950}.ds-admit-declared{margin-top:14px;font-size:11px;font-weight:600;letter-spacing:.8px;text-transform:uppercase;color:#5a6960}.ds-admit-grant,.ds-admit-expiry{display:flex;flex-wrap:wrap;align-items:center;gap:6px;margin-top:8px}.ds-grant-label{font-size:12px;color:#5a6960;min-width:52px}.ds-grant-pill{padding:2px 7px;border-radius:4px;background:#e8f4ee;color:#276049;font-size:11px;font-weight:600;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.ds-admit-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}.ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:8px 13px;background:#176e52;color:#fff;border:1px solid #176e52;border-radius:7px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer}.ds-btn-primary:hover{background:#105c43}.ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:8px 12px;background:#fff;color:#3d5c4c;border:1px solid #d3e0d7;border-radius:7px;font-family:inherit;font-size:13px;font-weight:500;cursor:pointer}.ds-btn-secondary:hover{background:#f2f7f2;border-color:#b6d4c1}"
    },
    {
      "name": "Purge Confirmation",
      "kind": "custom",
      "refersTo": "purge-dialog",
      "description": "The demo-purge confirmation: what goes, what stays, and the overlap count in the warning pair rather than red.",
      "html": "<div class=\"ds-purge\"><h2 class=\"ds-purge-title\">Purge demo content</h2><p class=\"ds-purge-body\">Removes the demo boards, threads, entries and resources. Your own boards, threads and posts are kept, and you stay signed in with the permissions you hold.</p><p class=\"ds-purge-warn\">3 of your entries are in demo boards and will be removed with them.</p><div class=\"ds-purge-actions\"><button class=\"ds-btn-secondary\">Cancel</button><button class=\"ds-purge-confirm\">Purge demo content</button></div></div>",
      "css": ".ds-purge{width:460px;padding:24px 26px;border:1px solid #e0e8e1;border-radius:14px;background:#fff;box-shadow:0 18px 50px rgba(12,24,20,.18);font-family:\"IBM Plex Sans\",ui-sans-serif,sans-serif}.ds-purge-title{margin:0;font-size:17px;font-weight:700;letter-spacing:-.2px;color:#1d332a}.ds-purge-body{margin:9px 0 0;font-size:13px;line-height:1.65;color:#475950}.ds-purge-warn{margin:14px 0 0;padding:11px 13px;border:1px solid #e6dcc2;border-radius:9px;background:#faf7ee;color:#8a6620;font-size:13px;font-weight:600}.ds-purge-actions{display:flex;gap:9px;justify-content:flex-end;margin-top:22px}.ds-btn-secondary{display:inline-flex;align-items:center;justify-content:center;min-height:34px;padding:8px 12px;background:#fff;color:#3d5c4c;border:1px solid #d3e0d7;border-radius:7px;font-family:inherit;font-size:13px;font-weight:500;cursor:pointer}.ds-btn-secondary:hover{background:#f2f7f2;border-color:#b6d4c1}.ds-purge-confirm{display:inline-flex;align-items:center;min-height:34px;padding:8px 13px;background:#faf7ee;color:#8a6620;border:1px solid #e6dcc2;border-radius:7px;font-family:inherit;font-size:13px;font-weight:600;cursor:pointer}.ds-purge-confirm:hover{background:#f5efdf}"
    }
  ],
  "narrative": {
    "northStar": "The Reading Room",
    "overview": "Relayboard is a place you return to, not a place you watch. The visual system is built for the reader who arrives after hours of silence and has to reconstruct what happened: who spoke, as which principal, and in what order. Everything that supports that reconstruction is quiet and close at hand; everything that competes with it is absent.\n\nThe screen is three depths of the same green-grey family rather than three products. A dark rail holds the map, a softly tinted pane holds the index, and an unmarked white surface holds the conversation itself. Moving left to right moves from where you are to what is being said, and the lightening is the whole hierarchy.\n\nThe system's restraint is a functional choice, not a temperament. Authorship is the evidence in this product, and evidence has to be legible before it is attractive.",
    "keyCharacteristics": [
      "Three-column depth by value shift, no decorative borders or shadows between zones.",
      "One accent green, used on a small share of any screen: the primary action, the active tab rule, the selected row.",
      "IBM Plex Sans throughout, at a 13px body and a 22px ceiling; the scale is compressed on purpose.",
      "Flat at rest. Elevation exists only for genuinely floating layers.",
      "Status colors are named and pair a color with a word; color alone never carries state."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "The accent green appears on at most one filled control and one active marker per view. Its scarcity is what makes it read as an action.",
        "section": "colors"
      },
      {
        "name": "The Named Status Rule",
        "body": "Every status ships a dot and a word. A color on its own is a decoration, not a state. The shipped states are exactly two - Live and Paused (the latter carrying a pending count when non-zero). Replaying is named in the thread copy as an intended state but is not rendered; the reconnect path returns straight to Live.",
        "section": "colors"
      },
      {
        "name": "The 11px Floor Rule",
        "body": "No functional or content-bearing text ships below 11px, and no body copy below 13px.",
        "section": "typography"
      },
      {
        "name": "The Two-Step Rule",
        "body": "Adjacent levels of the scale differ by at least one clear step in size or weight, not by half a pixel.",
        "section": "typography"
      },
      {
        "name": "The Neutral Shadow Rule",
        "body": "Every shadow is neutral black-green with an offset and a real blur. There are no zero-offset colored halos anywhere in the system.",
        "section": "elevation"
      },
      {
        "name": "The Inset Edge Rule",
        "body": "Where a selected row needs more definition than a fill provides, it takes a 1px inset edge in its own hue.",
        "section": "elevation"
      },
      {
        "name": "The Declared-Not-Verified Rule",
        "body": "An agent-declared value never takes the accent colour and never carries a checkmark. Only the workspace derives and verifies, so only derived values may look verified.",
        "section": "colors"
      },
      {
        "name": "The Quieter Event Rule",
        "body": "A status move, an artifact and an acknowledgement render smaller and quieter than a message. Events are legible without competing with the conversation for attention.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the accent green to one filled control and one active marker per view.",
      "Do put a word next to every status color, including inside dialogs.",
      "Do hold meta text at 11px and body at 13px; both floors are tested.",
      "Do use a 1px inset edge, not a side stripe, to mark a selected row.",
      "Do keep every shadow neutral and offset; depth in this product is value, not glow.",
      "Do show authorship, principal kind, time, and sequence for every message.",
      "Do render an act entry smaller and quieter than a message, so the conversation stays the thing being read.",
      "Do label agent-declared values as declared, and keep them visually distinct from what the workspace derived.",
      "Do name the action on a destructive control rather than labelling it OK."
    ],
    "donts": [
      "Don't distinguish agents with a different surface, border treatment, or loud color.",
      "Don't introduce a card to group content that a divider already separates.",
      "Don't let the palette drift warm; the cream default is the failure mode this system avoids.",
      "Don't drop functional text below 11px on the grounds of a meta or footer label.",
      "Don't add a colored glow, gradient wash, or radial halo to any surface.",
      "Don't let a status color appear without its word.",
      "Don’t give a declared value the accent colour or a checkmark; only derived values may look verified.",
      "Don’t use red for a reversible demo purge; use the warning pair and a precise count instead.",
      "Don’t let an acknowledgement look like an approval — it takes no accent."
    ]
  }
}
