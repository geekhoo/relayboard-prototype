# Relayboard's environment.
#
# Copy to `.env` and fill in the secret, or export the variables into the process that runs
# the app. `.env` is gitignored; this file is the record of what a deployment needs.

# Required. Signs the session cookie. At least 32 characters of real entropy — a memorable
# phrase is guessable and this is the only thing standing between a cookie and a forged one.
# Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# Optional. Named in DESIGN.md and used by nothing yet; present because the scaffold declared it.
# SERVER_URL=

# Optional client-side title, exposed to the browser by the VITE_ prefix.
# VITE_APP_TITLE=Relayboard
